// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

model Paciente {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  telefono        String
  email           String   @unique
  fechaNacimiento DateTime @map("fecha_nacimiento")
  citas           Cita[]

  @@map("pacientes")
}

enum EspecialidadMedica {
  CARDIOLOGIA
  PEDIATRIA
  TRAUMATOLOGIA
  DERMATOLOGIA
  CLINICA_GENERAL
}

model Medico {
  id                 Int                @id @default(autoincrement())
  nombre             String
  apellido           String
  especialidadMedica EspecialidadMedica @map("especialidad_medica")
  telefono           String
  email              String             @unique
  citas              Cita[]

  @@map("medicos")
}

enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

model Cita {
  id         Int        @id @default(autoincrement())
  fecha      DateTime
  pacienteId Int        @map("paciente_id")
  paciente   Paciente   @relation(fields: [pacienteId], references: [id])
  medicoId   Int        @map("medico_id")
  medico     Medico     @relation(fields: [medicoId], references: [id])
  estado     EstadoCita @default(PROGRAMADA)

  @@map("citas")
}

enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role

  @@map("users")
}