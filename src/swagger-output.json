{
  "openapi": "3.0.0",
  "info": {
    "title": "API Clínica Salud Integral",
    "description": "Documentación de la API para la gestión de pacientes, médicos, citas y reportes de la Clínica Salud Integral. Proyecto del curso FUNVAL.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registro e inicio de sesión (sin token)"
    },
    {
      "name": "Pacientes",
      "description": "Módulo de Recepción — expediente de pacientes"
    },
    {
      "name": "Médicos",
      "description": "Directorio y agenda de médicos"
    },
    {
      "name": "Citas",
      "description": "Agendamiento y atención de citas"
    },
    {
      "name": "Reportes",
      "description": "Reportes de gerencia"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/patients/": {
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Crear un nuevo paciente",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Paciente creado"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Error al crear el paciente"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "apellido",
                  "telefono",
                  "email",
                  "fechaNacimiento"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Juan"
                  },
                  "apellido": {
                    "type": "string",
                    "example": "Pérez"
                  },
                  "telefono": {
                    "type": "string",
                    "example": "3811234567"
                  },
                  "email": {
                    "type": "string",
                    "example": "juan.perez@mail.com"
                  },
                  "fechaNacimiento": {
                    "type": "string",
                    "format": "date",
                    "example": "1990-05-14"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Listar todos los pacientes",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array de pacientes"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Error al obtener los pacientes"
          }
        }
      }
    },
    "/api/patients/{id}": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Expediente completo del paciente (con historial de citas)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del paciente"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paciente con su array de citas (vacío si no tiene ninguna)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Paciente no encontrado"
          },
          "500": {
            "description": "Error al obtener el paciente"
          }
        }
      }
    },
    "/api/doctors/": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Listar médicos (directorio de solo lectura)",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "specialty",
            "in": "query",
            "description": "Filtrar por especialidad",
            "required": false,
            "enum": [
              "CARDIOLOGIA",
              "PEDIATRIA",
              "TRAUMATOLOGIA",
              "DERMATOLOGIA",
              "CLINICA_GENERAL"
            ],
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array de médicos"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Error al obtener los doctores"
          }
        }
      }
    },
    "/api/doctors/{id}/appointments": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Agenda del médico por rango de fechas",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del médico"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Fecha desde (YYYY-MM-DD)",
            "required": false,
            "example": "2026-11-01",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Fecha hasta (YYYY-MM-DD)",
            "required": false,
            "example": "2026-12-31",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array de citas del médico en el rango, con los datos del paciente de cada una"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Error al obtener la agenda del médico"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registrar un nuevo usuario",
        "description": "",
        "responses": {
          "201": {
            "description": "Usuario creado (sin password)"
          },
          "500": {
            "description": "Error al registrar el usuario"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "recepcion@test.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "RECEPCIONISTA",
                      "MEDICO",
                      "GERENCIA"
                    ],
                    "example": "RECEPCIONISTA"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Iniciar sesión",
        "description": "",
        "responses": {
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "500": {
            "description": "Error al iniciar sesión"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "recepcion@test.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/appointments-by-specialty": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Rentabilidad por especialidad",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Total de citas agrupado por especialidad",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "especialidad": {
                        "type": "string"
                      },
                      "total_citas": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Error al generar el reporte por especialidad"
          }
        }
      }
    },
    "/api/reports/daily-cutoff": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Corte operativo diario",
        "description": "Cuenta solo las citas en estado COMPLETADA o CANCELADA del día indicado.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Fecha (YYYY-MM-DD)",
            "required": true,
            "example": "2026-12-01",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Total de citas COMPLETADA/CANCELADA agrupado por estado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "estado": {
                        "type": "string"
                      },
                      "_count": {
                        "type": "object",
                        "properties": {
                          "estado": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Error al generar el corte operativo diario"
          }
        }
      }
    },
    "/api/appointments/": {
      "post": {
        "tags": [
          "Citas"
        ],
        "summary": "Agendar una nueva cita",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cita creada con estado PROGRAMADA"
          },
          "400": {
            "description": "Fecha en el pasado"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Paciente o médico no encontrado"
          },
          "500": {
            "description": "Error al agendar la cita"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pacienteId",
                  "medicoId",
                  "fecha"
                ],
                "properties": {
                  "pacienteId": {
                    "type": "integer",
                    "example": 1
                  },
                  "medicoId": {
                    "type": "integer",
                    "example": 1
                  },
                  "fecha": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-12-01"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/appointments/{id}/status": {
      "patch": {
        "tags": [
          "Citas"
        ],
        "summary": "Cambiar el estado de una cita",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID de la cita"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cita actualizada"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Cita no encontrada"
          },
          "500": {
            "description": "Error al actualizar el estado de la cita"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "estado"
                ],
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "COMPLETADA",
                      "CANCELADA"
                    ],
                    "example": "COMPLETADA"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Pegá tu token acá."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}